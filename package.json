{
  "name": "@47ng/actions-clever-cloud",
  "version": "2.2.0",
  "private": true,
  "description": "GitHub Action to deploy to Clever Cloud",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/47ng/actions-clever-cloud.git"
  },
  "keywords": [
    "actions",
    "node",
    "deploy",
    "deployment",
    "clever-cloud"
  ],
  "author": {
    "name": "François Best",
    "email": "contact@francoisbest.com",
    "url": "https://francoisbest.com"
  },
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node --env-file=.env.local --watch ./src/main.ts",
    "build": "tsdown src/main.ts --outDir dist --no-fixed-extension",
    "test": "vitest --typecheck",
    "knip": "knip"
  },
  "engines": {
    "node": "^26.13.0"
  },
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "clever-tools": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "knip": "^6.44.2",
    "msw": "^3.0.4",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "arrowParens": "avoid"
  }
}
